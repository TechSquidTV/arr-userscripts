# Shared non-secret build-time settings. Copy to .env.local and supply your own values.
# API keys and Plex tokens are intentionally requested at runtime and are never built in.
ARR_SONARR_URL=http://sonarr.local:8989
ARR_SONARR_ROOT_FOLDER=/tv
ARR_SONARR_QUALITY_PROFILE_ID=1
# Leave blank for Sonarr versions that do not require a language profile.
ARR_SONARR_LANGUAGE_PROFILE_ID=
ARR_SONARR_MONITORED=true
ARR_SONARR_SEARCH_FOR_MISSING_EPISODES=true

# Radarr settings used by the IMDb movie userscript.
ARR_RADARR_URL=http://radarr.local:7878
ARR_RADARR_ROOT_FOLDER=/movies
ARR_RADARR_QUALITY_PROFILE_ID=1
ARR_RADARR_MONITORED=true
ARR_RADARR_SEARCH_FOR_MOVIE=true

# Optional but recommended: enables definitive Plex media-type checks.
ARR_PLEX_SERVER_URL=http://plex.local:32400
# Optional comma-separated Plex Web origins. ARR_PLEX_SERVER_URL is included automatically.
ARR_PLEX_WEB_URLS=https://plex.example.com
