{
  "name": "arr-userscripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "build:release": "vp run -r release",
    "check": "vp check",
    "dev": "vp run -r --parallel dev",
    "ready": "vp check && vp test && vp run -r build",
    "test": "vp test"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
